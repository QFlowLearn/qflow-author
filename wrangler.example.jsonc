{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qflow-author",
  "services": [{ "binding": "QFLOW_PRINT_RENDERER", "service": "qflow-print-renderer" }],
  "main": "deploy/cloudflare/worker.entry.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *", "*/2 * * * *", "0 3 * * *"]
  },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },

  // Keep real account IDs, routes, bucket names, and Hyperdrive IDs
  // in a private deploy repo or local wrangler.jsonc. Do not commit them here.
  // "account_id": "PRIVATE_ACCOUNT_ID",
  // "routes": [
  //   { "pattern": "app.example.com", "custom_domain": true }
  // ],

  "vars": {
    "QFLOW_ORGANIZATION_GATEWAY_ID": "YOUR_GATEWAY_ID",
    "QFLOW_ORGANIZATION_MODEL_VERSION": "clef",
    "QFLOW_ORGANIZATION_INPUT_MICROS_PER_MILLION": "240000",
    "QFLOW_ORGANIZATION_RUN_BUDGET_MICROS": "1000000",
    "QFLOW_ENRICHMENT_PROVIDER": "cloudflare",
    "QFLOW_ENRICHMENT_MODEL": "@cf/deepseek-ai/deepseek-v4-flash-0731",
    "QFLOW_ENRICHMENT_INPUT_MICROS_PER_MILLION": "440000",
    "QFLOW_ENRICHMENT_OUTPUT_MICROS_PER_MILLION": "1320000",
    "QFLOW_ENRICHMENT_PREVIEW_BUDGET_MICROS": "1000000",
    "QFLOW_ENRICHMENT_RUN_BUDGET_MICROS": "25000000",
    "QFLOW_APP_ORIGIN": "https://app.example.com",
    "QFLOW_DELIVERY_PUBLISH_URL": "https://take.example.com/internal/qflow/publish",
    "QFLOW_DELIVERY_CAPABILITY_URL": "https://take.example.com/internal/qflow/capability",
    "QFLOW_DELIVERY_STATE_URL": "https://take.example.com/internal/qflow/state",
    "QFLOW_DELIVERY_SSO_LAUNCH_URL": "https://take.example.com/api/qflow/sso/launch",
    "QFLOW_AI_PROVIDER": "cloudflare",
    "QFLOW_CLOUDFLARE_AI_MODEL": "@cf/moonshotai/kimi-k2.6",
    "QFLOW_EMAIL_FROM": "QFlowLearn <hello@example.test>",
    "QFLOW_STORAGE_BACKEND": "r2-binding",
    "QFLOW_SECURE_COOKIES": "true",
    "QFLOW_AUTHORING_GATEWAY_ID": "qflow-authoring",
    "QFLOW_AUTHORING_MODEL_VERSION": "clef"
  },

  "send_email": [
    {
      "name": "QFLOW_EMAIL",
      "allowed_sender_addresses": ["hello@example.test"]
    }
  ],

  "ratelimits": [
    {
      "name": "QFLOW_AUTHORING_RATE_LIMIT",
      "namespace_id": "41003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "QFLOW_PASSWORD_RESET_ACCOUNT_RATE_LIMIT",
      "namespace_id": "41001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "QFLOW_PASSWORD_RESET_ORIGIN_RATE_LIMIT",
      "namespace_id": "41002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "workflows": [
    {
      "name": "qflow-assessment-print",
      "binding": "QFLOW_ASSESSMENT_PRINT_WORKFLOW",
      "class_name": "AssessmentPrintWorkflow"
    },
    {
      "name": "qflow-question-organization",
      "binding": "QFLOW_QUESTION_ORGANIZATION_WORKFLOW",
      "class_name": "QuestionOrganizationWorkflow"
    },
    {
      "name": "qflow-bank-enrichment",
      "binding": "QFLOW_BANK_ENRICHMENT_WORKFLOW",
      "class_name": "BankEnrichmentWorkflow"
    },
    {
      "name": "qflow-migration-commit",
      "binding": "QFLOW_MIGRATION_COMMIT_WORKFLOW",
      "class_name": "MigrationCommitWorkflow"
    },
    {
      "name": "qflow-source-migration",
      "binding": "QFLOW_SOURCE_MIGRATION_WORKFLOW",
      "class_name": "SourceMigrationWorkflow"
    },
    {
      "name": "qflow-ai-generation",
      "binding": "QFLOW_AI_GENERATION_WORKFLOW",
      "class_name": "AiGenerationWorkflow"
    },
    {
      "name": "qflow-release-build",
      "binding": "QFLOW_RELEASE_BUILD_WORKFLOW",
      "class_name": "ReleaseBuildWorkflow"
    }
  ],

  "hyperdrive": [
    {
      "binding": "QFLOW_DB",
      "id": "00000000000000000000000000000000"
    }
  ],

  "r2_buckets": [
    {
      "binding": "QFLOW_UPLOADS",
      "bucket_name": "qflow-example-uploads"
    }
  ]
}
