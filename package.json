{
  "name": "qflow-author",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "setup:local": "node --import tsx tools/setup_local.ts",
    "doctor": "node --env-file-if-exists=.env.local --import tsx tools/doctor.ts",
    "dev": "node --env-file-if-exists=.env.local --import tsx tools/dev_server.ts",
    "preview": "node --env-file-if-exists=.env.local --import tsx tools/preview.ts",
    "build": "pnpm run tw:build && node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js build",
    "typecheck": "node --import tsx tools/check_source.ts",
    "lint": "node --import tsx tools/lint.ts && node --import tsx tools/check_qti3_module_size.ts",
    "format": "node --import tsx tools/format.ts --write",
    "format:check": "node --import tsx tools/format.ts",
    "maintainability": "node --import tsx tools/maintainability_check.ts",
    "check:i18n": "node --import tsx tools/check_i18n.ts",
    "check:assessment-bundle": "node --import tsx tools/check_assessment_authoring_bundle.ts",
    "verify": "node --env-file-if-exists=.env.local --import tsx tools/verify.ts --database=qflow_test",
    "verify:ci": "node --import tsx tools/verify.ts --database=qflow_ci_test",
    "tw:build": "tailwindcss -i static/tailwind.css -o static/tw.css",
    "tw:watch": "tailwindcss -i static/tailwind.css -o static/tw.css -w",
    "test": "node --env-file-if-exists=.env.local --import tsx tools/testing/run.ts ordinary --database=qflow_test",
    "test:qa": "node --env-file-if-exists=.env.local --import tsx tools/testing/qa.ts",
    "test:cloudflare:built": "node --env-file-if-exists=.env.local --import tsx tools/testing/run.ts worker --database=qflow_test",
    "test:cloudflare": "pnpm run build && pnpm run test:cloudflare:built",
    "test:e2e": "pnpm run build && pnpm run test:e2e:built",
    "test:e2e:built": "node --env-file-if-exists=.env.local --import tsx tools/testing/run.ts browser --database=qflow_test",
    "test:e2e:inventory": "node --import tsx tools/ci_browser.ts check",
    "test:e2e:shard": "node --import tsx tools/ci_browser.ts shard",
    "test:a11y:built": "node --env-file-if-exists=.env.local --import tsx tools/testing/run.ts a11y --database=qflow_test",
    "test:a11y:install": "playwright install --with-deps chromium",
    "validate:corpus": "node --import tsx tools/validate.ts --corpus",
    "validate:tests": "node --env-file-if-exists=.env.local --import tsx tools/validate.ts --tests",
    "validate:file": "node --import tsx tools/validate.ts --file",
    "validate:dir": "node --import tsx tools/validate.ts --dir build/qti",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx tools/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx tools/db.ts seed",
    "fixtures:respondus": "node --env-file-if-exists=.env.local --import tsx tools/respondus_fixture_corpus.ts --write",
    "fixtures:respondus:check": "node --import tsx tools/respondus_fixture_corpus.ts --check",
    "demo:compatibility": "node --import tsx tools/generate_demo_compatibility.ts",
    "demo:compatibility:check": "node --import tsx tools/generate_demo_compatibility.ts --check",
    "cloudflare:dry-run": "node --env-file-if-exists=.env.local --import tsx tools/check_configuration.ts --dry-run",
    "check:runtime": "node --import tsx tools/check_dependencies.ts",
    "validate": "node --env-file-if-exists=.env.local --import tsx tools/validate.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@formatjs/intl": "4.1.19",
    "@longsightgroup/qti3-core": "0.13.4",
    "@longsightgroup/qti3-migrator": "0.13.4",
    "@longsightgroup/qti3-player": "0.13.4",
    "@longsightgroup/qti3-pnp": "0.13.4",
    "@longsightgroup/qti3-transcoder": "0.13.4",
    "@longsightgroup/qti3-writer": "0.13.4",
    "@prosekit/basic": "0.6.6",
    "@prosekit/core": "0.8.7",
    "@prosekit/extensions": "0.12.2",
    "@prosekit/pm": "0.1.14",
    "@prosekit/preact": "0.6.2",
    "@xmldom/xmldom": "0.8.15",
    "@zip.js/zip.js": "2.8.26",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.13.16",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "preact": "10.29.1",
    "preact-render-to-string": "6.7.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "1.0.0-rc.2",
    "@cloudflare/config": "1.0.0-rc.2",
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "5.20261119.1",
    "@dprint/json": "0.26.0",
    "@dprint/markdown": "0.29.0",
    "@dprint/typescript": "0.101.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "axe-core": "4.14.1",
    "cf": "1.0.0-rc.2",
    "daisyui": "5.8.1",
    "dprint": "0.65.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261118.0-beta",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  }
}
