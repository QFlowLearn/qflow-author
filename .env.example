# Copy to .env.local. This is the only local environment file.
# Use PostgreSQL 17 on loopback. setup:local creates qflow_local and qflow_test when the role
# has CREATEDB; otherwise create both with a local administrator (docs/development.md).
DATABASE_URL=postgres://qflow:qflow@127.0.0.1:5433/qflow_local

# The application runs locally in workerd with bindings from cloudflare.config.ts.
QFLOW_APP_ORIGIN=https://127.0.0.1:5173
# Internal listener. Cloud workspaces use HTTP behind their authenticated HTTPS preview proxy.
QFLOW_DEV_ORIGIN=https://127.0.0.1:5173
QFLOW_SECURE_COOKIES=true
QFLOW_ROOT_DOMAIN=
QFLOW_COOKIE_DOMAIN=
QFLOW_STORAGE_BACKEND=r2-binding
QFLOW_AI_PROVIDER=cloudflare
QFLOW_EMAIL_FROM=QFlowLearn <hello@qflowlearn.com>
QFLOW_SIGNUP_NOTIFY_BCC=

# setup:local generates missing secrets once and preserves existing values.
QFLOW_RUNNER_KEY=
QFLOW_CREDENTIAL_ENCRYPTION_KEY_V1=

# setup:local provisions the leaf certificate using your existing mkcert CA.
# Trust the CA yourself before setup; setup never changes system certificate trust.
QFLOW_DEV_TLS_CERT=.artifacts/local-dev/cert.pem
QFLOW_DEV_TLS_KEY=.artifacts/local-dev/key.pem
# setup:local records the absolute mkcert rootCA.pem path here.
NODE_EXTRA_CA_CERTS=

# External delivery is unconfigured locally. No production delivery requests are enabled by setup.
QFLOW_DELIVERY_PUBLISH_URL=
QFLOW_DELIVERY_CAPABILITY_URL=
QFLOW_DELIVERY_STATE_URL=
QFLOW_DELIVERY_SSO_LAUNCH_URL=
QFLOW_DELIVERY_SIGNING_SECRET=
